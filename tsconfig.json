{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "types": [
      "bun-types"
    ],

    "rootDir": "./src",
    "outDir": "./dist",

    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },

  "include": [
    "src"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "prisma"
  ]
}