{
    "compilerOptions": {
        /* Language */
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        /* Paths */
        "baseUrl": "./src",
        "paths": {
            "@/*": ["./*"]
        },

        /* Strict */
        "strict": true,
        "skipLibCheck": true,

        /* Types */
        "types": [
            "bun-types",
            "node"
        ],

        /* Output */
        "rootDir": "./src",
        "outDir": "./dist",

        /* JSX */
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",

        /* Interop */
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,

        /* Quality of Life */
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "noEmit": true
    },

    "include": [
        "src"
    ],

    "exclude": [
        "node_modules",
        "dist",
        "prisma"
    ]
}